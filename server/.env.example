# Server-only secrets. Copy this to server/.env. Never commit the real file.
PORT=3001
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Brevo settings. Brevo uses HTTPS, so this works on Render Free.
# BREVO_FROM_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_EMAIL=your-verified-sender@gmail.com
BREVO_FROM_NAME=MediMama

# Resend settings. Resend uses HTTPS, so this works on Render Free.
# Use a verified sender domain for delivery to other users. In Resend test mode,
# messages can only be sent to the email address that owns the Resend account.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="MediMama <notifications@your-verified-domain.com>"

# Optional SMTP fallback for local development. For Gmail, use an app password
# instead of your normal password. Render Free blocks SMTP ports 25, 465, and 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
MAIL_FROM="MediMama <your-sending-account@gmail.com>"
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
REMINDER_POLL_MS=60000
