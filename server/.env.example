# Server-only secrets. Copy this to server/.env. Never commit the real file.
PORT=3001
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# SMTP settings. For Gmail, use an app password instead of your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
MAIL_FROM="MediMama <your-sending-account@gmail.com>"
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
REMINDER_POLL_MS=60000
